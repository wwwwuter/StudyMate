{
  "name": "studymate-desktop",
  "version": "1.0.0",
  "description": "StudyMate - AI智能考研学习助手",
  "main": "electron/main.js",
  "scripts": {
    "dev:vue": "vite",
    "build:vue": "vue-tsc --noEmit && vite build",
    "dev:electron": "electron .",
    "dev": "concurrently \"npm run dev:vue\" \"wait-on http://localhost:5173 && npm run dev:electron\"",
    "build": "npm run build:vue && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "dayjs": "^1.11.11",
    "echarts": "^5.5.1",
    "element-plus": "^2.7.7",
    "pinia": "^2.1.7",
    "vue": "^3.4.30",
    "vue-router": "^4.4.0",
    "vue-echarts": "^7.0.3"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.5",
    "concurrently": "^8.2.2",
    "electron": "^31.1.0",
    "electron-builder": "^24.13.3",
    "sass": "^1.77.6",
    "typescript": "^5.5.2",
    "vite": "^5.3.3",
    "vue-tsc": "^2.0.22",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.studymate.app",
    "productName": "StudyMate",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/icon.png"
    }
  }
}