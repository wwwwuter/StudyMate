# ===== 数据库 =====
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=studymate
# 或直接提供完整 URL（优先于上面的分段）
# DATABASE_URL=mysql+pymysql://root:@localhost:3306/studymate?charset=utf8mb4

# ===== JWT =====
SECRET_KEY=change-me
JWT_SECRET=change-me-jwt
JWT_EXPIRATION_HOURS=72
JWT_ACCESS_EXPIRATION_HOURS=2
JWT_REFRESH_EXPIRATION_DAYS=30

# ===== 微信小程序（扫码登录，本地留空则走 mock）=====
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_MOCK=true
LOGIN_QR_EXPIRE_SECONDS=300
QR_LOGIN_BASE_URL=studymate://login

# ===== Phase 8：DeepSeek / RAG =====
# DeepSeek API Key（留空则 AI 功能降级：报告/提取走模板或报错提示）
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=60
DEEPSEEK_MAX_RETRIES=3

# RAG 知识库（本地 sentence-transformers 向量化，首次使用自动下载模型）
RAG_EMBEDDING_MODEL=shibing624/text2vec-base-chinese
RAG_CHUNK_SIZE=400
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=4
RAG_SIM_THRESHOLD=0.25
# RAG_INDEX_DIR 默认 <项目根>/data/rag，可在此覆盖

# ===== 提醒系统（Phase 6）=====
REMINDER_ENABLED=true
REMINDER_LEAD_MINUTES=10
REMINDER_SWEEP_INTERVAL=60
REMINDER_GRACE_MINUTES=2
REMINDER_MAX_LOOKAHEAD=120

# ===== 其他降级开关 =====
# PDF 智能解析无密钥时走正则降级（true/false）
PDF_AI_MOCK=false
# 学习报告强制走模板降级（true/false），便于离线/CI
LEARNING_REPORT_MOCK=false
