# Flask
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=your-secret-key-change-in-production

# MySQL
# 方式一（推荐）：直接提供完整连接串
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/studymate
# 方式二：拆分片段（未设置 DATABASE_URL 时生效）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-password
MYSQL_DATABASE=studymate

# JWT
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRATION_HOURS=72

# DeepSeek AI
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_API_BASE=https://api.deepseek.com
# PDF 智能解析降级开关：无 DEEPSEEK_API_KEY 时置 true，可使 /api/tasks/import/pdf/ai 走正则解析
PDF_AI_MOCK=false

# WeChat Mini Program
WECHAT_APP_ID=your-wechat-app-id
WECHAT_APP_SECRET=your-wechat-app-secret

# 扫码登录相关
WECHAT_MOCK=false                       # 本地开发/测试置 true，使用 mock openid 跳过真实微信接口
LOGIN_QR_EXPIRE_SECONDS=300            # 二维码票据有效期（秒）
QR_LOGIN_BASE_URL=studymate://login    # 二维码内容前缀，桌面端/小程序据此识别扫码登录

# JWT 双令牌
JWT_ACCESS_EXPIRATION_HOURS=2          # access token 有效期（小时）
JWT_REFRESH_EXPIRATION_DAYS=30         # refresh token 有效期（天）

# 解析依赖（按需 pip install）
# PDF 导入需：pdfminer.six   （backend/parser/pdf_parser.py 延迟导入）
# Excel 导入需：openpyxl     （requirements.txt 已含，版本 3.1.5）
# 未安装 pdfminer.six 时调用 /api/tasks/import/pdf 会返回「PDF 解析依赖未安装」提示。