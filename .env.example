# StudyMate Web 化部署环境变量示例
# 复制为 .env 后填入真实值（不要提交真实 .env 到仓库）

# ---- 数据库（MySQL）----
MYSQL_ROOT_PASSWORD=change_me_root_pwd
MYSQL_USER=studymate
MYSQL_PASSWORD=change_me_db_pwd
MYSQL_DATABASE=studymate

# ---- 应用密钥（务必改成强随机值，且保密）----
# 用于 JWT 与会话令牌签名
SECRET_KEY=please_generate_a_long_random_secret
# 用于 JWT（若未设则回退 SECRET_KEY）
JWT_SECRET_KEY=please_generate_another_long_random_secret

# ---- Web 化开关 ----
# 收紧 CORS：填前端站域名（逗号分隔）；本地同源演示可留 *
CORS_ORIGINS=https://yourdomain.com
# 对学生第三方 API Key 做静态加密（网站部署强烈建议 true）
AI_KEY_ENCRYPT=true

# ---- 后端运行配置 ----
FLASK_ENV=production
REMINDER_ENABLED=true

# ---- DeepSeek / RAG（可选；学生也可在设置页填自己的 Key）----
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
RAG_INDEX_DIR=/app/data/rag
RAG_EMBEDDING_MODEL=shibing624/text2vec-base-chinese

# ---- 前端构建时（Vite）----
# 同源部署（nginx 反代 /api）时留空；
# 跨域独立域名时填后端 API 地址：VITE_API_BASE=https://api.yourdomain.com
